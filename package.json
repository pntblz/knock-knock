{
  "name": "knock-knock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply knock-knock --remote",
    "db:migrate:local": "wrangler d1 migrations apply knock-knock --local",
    "register": "node --env-file=.dev.vars scripts/register-commands.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "typescript": "^5.6.3",
    "vitest": "^4.0.0",
    "wrangler": "^4.45.0"
  }
}
